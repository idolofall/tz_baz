# In Docker: host=postgres, port=5432. From host machine: host=localhost, port=5433
DATABASE_URL=postgresql+asyncpg://payments:payments@postgres:5432/payments
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
API_KEY=dev-api-key-change-me
OUTBOX_POLL_INTERVAL_SEC=1.0
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_BASE_DELAY_SEC=1.0
PAYMENT_PROCESS_MIN_SEC=2.0
PAYMENT_PROCESS_MAX_SEC=5.0
PAYMENT_SUCCESS_RATE=0.9
CONSUMER_MAX_RETRIES=3
PAYMENTS_EXCHANGE=payments
PAYMENTS_ROUTING_KEY=payments.new
